# NCERT → NotebookLM pipeline — settings and secrets.
#
#   cp .env.example .env     then fill in .env
#
# .env is git-ignored. Never commit real values — only this example file.
# Variables already set in your shell take precedence over this file.

# ── Google Drive ──────────────────────────────────────────────────────────
# OAuth client from Google Cloud Console:
#   APIs & Services → Credentials → Create credentials → OAuth client ID
#   → Application type: "Desktop app" → copy the Client ID and Client secret.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=

# Top-level folder in "My Drive" that mirrors output/.
DRIVE_ROOT_FOLDER=Lernoverse NCERT

# ── MongoDB ───────────────────────────────────────────────────────────────
# The same database the phoenix backend uses — copy MONGODB_URI from
# Lernoverse/phoenix/.env.
#   e.g. mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>
MONGODB_URI=

# Only needed when MONGODB_URI has no /<database> at the end.
MONGODB_DB=
