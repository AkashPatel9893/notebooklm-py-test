# ── Google Sheets
SHEET_ID=1pvR_vpZjeEK9d3UxuFaFGX0GS_S8ObUu_dS6jWmlKeE

# ── Google Drive
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=

# Top-level folder in "My Drive" that mirrors output/.
DRIVE_ROOT_FOLDER=Lernoverse NCERT

# ── YouTube (same OAuth client as Drive; sign in with `python run.py youtube-login`)
YOUTUBE_REFRESH_TOKEN=
# public / unlisted (default) / private — applies to new AND already-uploaded videos.
# Videos go to YouTube instead of Drive once signed in. Forced private until Google audits the API project.
YOUTUBE_PRIVACY=public
# Daily API quota of the Cloud project (10000 unless Google raised it). A call
# that wouldn't fit in what's left today is never sent. Set it lower if other
# apps share the same Cloud project, to leave them their part.
YOUTUBE_DAILY_QUOTA=10000
# Tries per YouTube call within a run on network errors / 5xx / rate limits (30s, 60s… apart).
YOUTUBE_ATTEMPTS=3
# Minimum seconds between any two YouTube API calls, and between two uploads.
YOUTUBE_CALL_GAP=1
YOUTUBE_UPLOAD_GAP=60
# Classes up to this one are marked "made for kids" on YouTube (COPPA: no
# comments, no personalised ads). 0 = none.
YOUTUBE_KIDS_MAX_CLASS=5

# ── MongoDB
MONGODB_URI=
MONGODB_DB=
